<Window x:Class="WidgetNotes.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:WidgetNotes"
        Title="Notiz"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- Werden in ApplyStyle() ersetzt -->
        <SolidColorBrush x:Key="Fg" Color="#F5F5F7" />
        <SolidColorBrush x:Key="Secondary" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FFD60A" />
        <SolidColorBrush x:Key="OnAccent" Color="#1C1C1E" />
        <SolidColorBrush x:Key="MenuAccent" Color="#FFD60A" />
        <SolidColorBrush x:Key="OnMenuAccent" Color="#1C1C1E" />
        <SolidColorBrush x:Key="ChipBg" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ChipHover" Color="#40FFFFFF" />
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <CornerRadius x:Key="Radius">22</CornerRadius>
        <CornerRadius x:Key="RadiusTop">22,22,0,0</CornerRadius>
        <sys:Double x:Key="BodyFontSize">14</sys:Double>

        <!-- Eine Aufgabe in der Liste -->
        <DataTemplate x:Key="TodoTemplate" DataType="{x:Type local:TodoItem}">
            <Grid x:Name="Row" Background="Transparent" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource CircleCheck}" IsChecked="{Binding Done}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBox x:Name="ItemText" Grid.Column="1" Style="{StaticResource BareTextBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                         FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodyFontSize}"
                         VerticalAlignment="Top" Cursor="IBeam" PreviewKeyDown="TodoText_PreviewKeyDown" />
                <Border x:Name="Chip" Grid.Column="2" CornerRadius="8" Padding="7,2" Margin="6,1,0,0"
                        VerticalAlignment="Top" Background="{DynamicResource ChipBg}" Cursor="Hand"
                        Visibility="Collapsed" MouseLeftButtonDown="DueChip_MouseLeftButtonDown" ToolTip="Termin ändern">
                    <TextBlock x:Name="ChipText" Text="{Binding DueLabel}" FontFamily="{DynamicResource UiFont}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
                </Border>
                <Button x:Name="DueButton" Grid.Column="3" Style="{StaticResource ChipButton}"
                        Width="22" Height="22" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Top"
                        Content="&#xE787;" ToolTip="Termin festlegen" Opacity="0" Click="DueButton_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="ItemText" Property="Opacity" Value="0.45" />
                    <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Chip" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDue}" Value="True">
                    <Setter TargetName="Chip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DueButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="today">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="overdue">
                    <Setter TargetName="Chip" Property="Background" Value="#38FF453A" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="#FF6961" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DueButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Tile" Margin="16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Hintergrund + Schatten (getrennt vom Text, damit der scharf bleibt) -->
        <Border x:Name="ShadowLayer" CornerRadius="{DynamicResource Radius}" Background="#1C1C20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="Body" CornerRadius="{DynamicResource Radius}" Background="Transparent"
                MouseLeftButtonDown="Body_MouseLeftButtonDown" Cursor="SizeAll">
            <Grid>
                <Border x:Name="Gloss" CornerRadius="{DynamicResource RadiusTop}" Height="70"
                        VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#16FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="{DynamicResource Radius}" BorderThickness="1" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40FFFFFF" Offset="0" />
                            <GradientStop Color="#0AFFFFFF" Offset="0.6" />
                            <GradientStop Color="#14000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Grid Margin="18,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Kopfzeile -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIcon" Text="&#xE70B;" FontFamily="{StaticResource Icons}" FontSize="12"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock x:Name="HeaderLabel" FontFamily="{DynamicResource UiFont}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="HoverButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Opacity="0" Cursor="Arrow">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource ChipButton}" Content="&#xE710;" ToolTip="Neue Notiz (Strg+N)" Click="New_Click" />
                        <Button x:Name="MoreButton" Style="{StaticResource ChipButton}" Content="&#xE712;" ToolTip="Optionen" Click="More_Click" />
                    </StackPanel>

                    <!-- Titel -->
                    <Grid Grid.Row="1" Margin="0,8,0,6" Cursor="IBeam">
                        <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}"
                                 FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                 MaxLength="80" TextChanged="Title_TextChanged" PreviewKeyDown="Title_PreviewKeyDown" />
                        <TextBlock x:Name="TitlePlaceholder" Text="Titel" IsHitTestVisible="False"
                                   FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Secondary}" Margin="2,0,0,0" />
                    </Grid>

                    <!-- Inhalt (unten sanft ausgeblendet) -->
                    <Grid Grid.Row="2">
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Black" Offset="0" />
                                <GradientStop Color="Black" Offset="0.84" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.OpacityMask>

                        <!-- Notiz -->
                        <Grid x:Name="TextContent" Cursor="IBeam">
                            <TextBox x:Name="Editor" Style="{StaticResource BareTextBox}"
                                     FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodyFontSize}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     TextChanged="Editor_TextChanged" />
                            <TextBlock x:Name="EditorPlaceholder" Text="Schreib etwas …" IsHitTestVisible="False"
                                       FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource Secondary}" Margin="2,0,0,0" />
                        </Grid>

                        <!-- Liste -->
                        <ScrollViewer x:Name="ListContent" Visibility="Collapsed" Focusable="False"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,18">
                                <ItemsControl x:Name="TodoList" ItemTemplate="{StaticResource TodoTemplate}" Focusable="False" />
                                <Grid Margin="0,3" Cursor="IBeam">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="{DynamicResource Secondary}" Width="18" TextAlignment="Center"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <TextBox x:Name="AddBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                                             FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodyFontSize}"
                                             TextChanged="AddBox_TextChanged" PreviewKeyDown="AddBox_PreviewKeyDown" />
                                    <TextBlock x:Name="AddPlaceholder" Grid.Column="1" Text="Neue Aufgabe" IsHitTestVisible="False"
                                               FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodyFontSize}"
                                               Foreground="{DynamicResource Secondary}" Margin="2,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Lösch-Bestätigung -->
                <Border x:Name="ConfirmOverlay" CornerRadius="{DynamicResource Radius}" Background="#EB141416"
                        Visibility="Collapsed" Opacity="0" Cursor="Arrow">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Notiz löschen?" Foreground="White" FontFamily="{StaticResource MenuFont}"
                                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Style="{StaticResource PillButton}" Content="Abbrechen" Click="CancelDelete_Click" />
                            <Button Style="{StaticResource PillButton}" Content="Löschen" Background="#FF453A" Click="ConfirmDelete_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Optionsmenü ================= -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom"
               HorizontalOffset="-236" VerticalOffset="-6" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade">
            <Grid Margin="16" Width="256">
                <Border CornerRadius="14" Background="{StaticResource MenuBg}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="14" Background="{StaticResource MenuBg}" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <Grid>
                        <!-- Hauptseite -->
                        <StackPanel x:Name="MainPage" Margin="6">
                            <TextBlock Text="TYP" Style="{StaticResource MenuLabel}" Margin="8,4,0,5" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="KindText" GroupName="Kind" Tag="text" Style="{StaticResource SegmentOption}" Click="Kind_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70B;" FontFamily="{StaticResource Icons}" Margin="0,2,7,0" />
                                        <TextBlock Text="Notiz" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="KindTodo" GroupName="Kind" Tag="todo" Style="{StaticResource SegmentOption}" Click="Kind_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource Icons}" Margin="0,2,7,0" />
                                        <TextBlock Text="Liste" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <TextBlock Text="GRÖSSE" Style="{StaticResource MenuLabel}" />
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="SizeSmall" GroupName="Size" Tag="Small" Style="{StaticResource SegmentOption}" Click="Size_Click" FontSize="11">
                                    <StackPanel>
                                        <Grid Width="28" Height="28"><Border Style="{StaticResource SizeIcon}" Width="13" Height="13" /></Grid>
                                        <TextBlock Text="Klein" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SizeMedium" GroupName="Size" Tag="Medium" Style="{StaticResource SegmentOption}" Click="Size_Click" FontSize="11">
                                    <StackPanel>
                                        <Grid Width="28" Height="28"><Border Style="{StaticResource SizeIcon}" Width="26" Height="13" /></Grid>
                                        <TextBlock Text="Mittel" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SizeLarge" GroupName="Size" Tag="Large" Style="{StaticResource SegmentOption}" Click="Size_Click" FontSize="11">
                                    <StackPanel>
                                        <Grid Width="28" Height="28"><Border Style="{StaticResource SizeIcon}" Width="26" Height="26" /></Grid>
                                        <TextBlock Text="Groß" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SizeTall" GroupName="Size" Tag="Tall" Style="{StaticResource SegmentOption}" Click="Size_Click" FontSize="11">
                                    <StackPanel>
                                        <Grid Width="28" Height="28"><Border Style="{StaticResource SizeIcon}" Width="13" Height="26" /></Grid>
                                        <TextBlock Text="Hoch" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <TextBlock Text="DESIGN" Style="{StaticResource MenuLabel}" />
                            <WrapPanel x:Name="SwatchPanel" Margin="4,0,4,2" />

                            <Button Style="{StaticResource MenuRow}" HorizontalContentAlignment="Stretch" Click="Customize_Click" Margin="0,4,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Foreground="{StaticResource MenuMuted}" />
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Anpassen …" />
                                </DockPanel>
                            </Button>

                            <Border Height="1" Background="#1FFFFFFF" Margin="6,4" />

                            <Button Style="{StaticResource MenuRow}" Click="MenuNew_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Neue Notiz" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearDoneRow" Style="{StaticResource MenuRow}" Click="ClearDone_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Erledigte entfernen" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRow}" Click="MenuDelete_Click" Foreground="#FF6961">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Notiz löschen" />
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#1FFFFFFF" Margin="6,4" />
                            <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Margin="10,6,10,6"
                                      Click="Autostart_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Mit Windows starten" />
                                </StackPanel>
                            </CheckBox>
                            <Button x:Name="UpdateRow" Style="{StaticResource MenuRow}" Click="Update_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="UpdateText" Text="Nach Updates suchen" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="VersionLabel" Style="{StaticResource MenuLabel}" FontWeight="Normal" Margin="10,2,0,6" />
                        </StackPanel>

                        <!-- Anpassen -->
                        <StackPanel x:Name="CustomizePage" Margin="6" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,2">
                                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Zurück" />
                                <TextBlock Text="Anpassen" Foreground="White" FontFamily="{StaticResource MenuFont}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </DockPanel>

                            <TextBlock Text="FARBEN" Style="{StaticResource MenuLabel}" Margin="8,4,0,6" />
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="Target0" GroupName="ColorTarget" Tag="0" Style="{StaticResource ColorTarget}" Content="Verlauf 1" Click="Target_Click" />
                                <RadioButton x:Name="Target1" GroupName="ColorTarget" Tag="1" Style="{StaticResource ColorTarget}" Content="Verlauf 2" Click="Target_Click" />
                                <RadioButton x:Name="Target2" GroupName="ColorTarget" Tag="2" Style="{StaticResource ColorTarget}" Content="Akzent" Click="Target_Click" />
                            </UniformGrid>
                            <local:ColorPicker x:Name="Picker" Margin="8,10,8,2" />

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource MenuLabel}" Margin="0,8,8,5" />
                                <TextBlock Text="DECKKRAFT" Style="{StaticResource MenuLabel}" />
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}" Minimum="0.1" Maximum="1" ValueChanged="Opacity_ValueChanged" />

                            <DockPanel>
                                <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" Style="{StaticResource MenuLabel}" Margin="0,8,8,5" />
                                <TextBlock Text="ECKEN" Style="{StaticResource MenuLabel}" />
                            </DockPanel>
                            <Slider x:Name="RadiusSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="40" ValueChanged="Radius_ValueChanged" />

                            <TextBlock Text="SCHRIFT" Style="{StaticResource MenuLabel}" />
                            <WrapPanel x:Name="FontPanel" Margin="2,0" />

                            <DockPanel>
                                <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right" Style="{StaticResource MenuLabel}" Margin="0,8,8,5" />
                                <TextBlock Text="SCHRIFTGRÖSSE" Style="{StaticResource MenuLabel}" />
                            </DockPanel>
                            <Slider x:Name="FontSizeSlider" Style="{StaticResource ModernSlider}" Minimum="10" Maximum="28"
                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="FontSize_ValueChanged" />

                            <Border Height="1" Background="#1FFFFFFF" Margin="6,8,6,4" />
                            <CheckBox x:Name="ShadowSwitch" Style="{StaticResource Switch}" Content="Schatten" Click="Shadow_Click" />
                            <CheckBox x:Name="GlossSwitch" Style="{StaticResource Switch}" Content="Glanz" Click="Gloss_Click" />
                            <Border Height="1" Background="#1FFFFFFF" Margin="6,4" />

                            <Button Style="{StaticResource MenuRow}" Click="ApplyAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="12" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Auf alle Notizen anwenden" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Popup>

        <!-- ================= Termin-Auswahl ================= -->
        <Popup x:Name="DuePopup" Placement="Bottom" HorizontalOffset="-200" VerticalOffset="-8"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Grid Margin="16" Width="262">
                <Border CornerRadius="14" Background="{StaticResource MenuBg}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="14" Background="{StaticResource MenuBg}" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <StackPanel Margin="10">
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource SmallPill}" Content="Heute" Tag="today" Click="QuickDue_Click" />
                            <Button Style="{StaticResource SmallPill}" Content="Morgen" Tag="tomorrow" Click="QuickDue_Click" />
                            <Button Style="{StaticResource SmallPill}" Content="Nächste Wo." Tag="nextweek" Click="QuickDue_Click" />
                        </UniformGrid>

                        <DockPanel Margin="0,10,0,4">
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76B;" Click="PrevMonth_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="NextMonth_Click" />
                            <TextBlock x:Name="MonthLabel" Foreground="White" FontFamily="{StaticResource MenuFont}" FontSize="13"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DockPanel>

                        <UniformGrid Columns="7" TextElement.Foreground="{StaticResource MenuMuted}"
                                     TextElement.FontFamily="{StaticResource MenuFont}" TextElement.FontSize="11">
                            <TextBlock Text="Mo" HorizontalAlignment="Center" />
                            <TextBlock Text="Di" HorizontalAlignment="Center" />
                            <TextBlock Text="Mi" HorizontalAlignment="Center" />
                            <TextBlock Text="Do" HorizontalAlignment="Center" />
                            <TextBlock Text="Fr" HorizontalAlignment="Center" />
                            <TextBlock Text="Sa" HorizontalAlignment="Center" />
                            <TextBlock Text="So" HorizontalAlignment="Center" />
                        </UniformGrid>
                        <UniformGrid x:Name="DayGrid" Columns="7" Rows="6" Margin="0,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="13"
                                       Foreground="{StaticResource MenuMuted}" VerticalAlignment="Center" Margin="4,0,10,0" />
                            <Border Grid.Column="1" CornerRadius="8" Background="#1FFFFFFF" Padding="10,6">
                                <Grid>
                                    <TextBox x:Name="TimeBox" Style="{StaticResource BareTextBox}" Foreground="White" CaretBrush="White"
                                             FontFamily="{StaticResource MenuFont}" FontSize="13"
                                             TextChanged="TimeBox_TextChanged" KeyDown="TimeBox_KeyDown" />
                                    <TextBlock x:Name="TimePlaceholder" Text="Uhrzeit, z. B. 14:30" IsHitTestVisible="False"
                                               Foreground="{StaticResource MenuMuted}" FontFamily="{StaticResource MenuFont}"
                                               FontSize="13" Margin="2,0,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <Button Style="{StaticResource SmallPill}" Content="09:00" Tag="09:00" Click="TimeChip_Click" />
                            <Button Style="{StaticResource SmallPill}" Content="12:00" Tag="12:00" Click="TimeChip_Click" />
                            <Button Style="{StaticResource SmallPill}" Content="18:00" Tag="18:00" Click="TimeChip_Click" />
                            <Button Style="{StaticResource SmallPill}" Content="20:00" Tag="20:00" Click="TimeChip_Click" />
                        </UniformGrid>

                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Content="Entfernen"
                                    Margin="0" Click="RemoveDue_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Fertig" Margin="0"
                                    Background="{DynamicResource MenuAccent}" Foreground="{DynamicResource OnMenuAccent}" Click="DueDone_Click" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
