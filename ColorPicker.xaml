<UserControl x:Class="WidgetNotes.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Sättigung / Helligkeit -->
        <Grid x:Name="SvArea" Height="118" Cursor="Cross" Background="Transparent"
              MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Area_MouseUp">
            <Border x:Name="HueLayer" CornerRadius="10" Background="Red" />
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Farbton -->
        <Grid x:Name="HueArea" Height="18" Margin="0,10,0,0" Cursor="Hand" Background="Transparent"
              MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Area_MouseUp">
            <Border CornerRadius="6" Height="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.167" />
                        <GradientStop Color="#00FF00" Offset="0.333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.667" />
                        <GradientStop Color="#FF00FF" Offset="0.833" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="18" Height="18" Stroke="White" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Hex -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PreviewSwatch" Width="26" Height="26" CornerRadius="7" BorderBrush="#40FFFFFF" BorderThickness="1" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="7" Background="#1FFFFFFF" Padding="9,4">
                <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center"
                         KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
